  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "ModelVisibility": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "model_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "operation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "title": {
            "type": "string"
          },
          "visibility": {
            "type": "string",
            "enum": [
              "VISIBLE",
              "HIDDEN"
            ]
          },
          "version": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "previous_visibility": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "VISIBLE",
                  "HIDDEN"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "provider",
          "model_id",
          "operation",
          "title",
          "visibility",
          "version",
          "previous_visibility"
        ]
      },
      "ModelVisibilityChange": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "model_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "operation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "visibility": {
            "type": "string",
            "enum": [
              "VISIBLE",
              "HIDDEN"
            ]
          },
          "rollback_of": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "minimum": 1
          },
          "expected_version": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "provider",
          "model_id",
          "operation",
          "visibility"
        ]
      },
      "ConsentDocuments": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string"
          },
          "terms": {
            "type": "string"
          },
          "privacy": {
            "type": "string"
          },
          "test_only": {
            "type": "boolean"
          }
        },
        "required": [
          "version",
          "terms",
          "privacy",
          "test_only"
        ]
      }
    }
  }
}
