PLATEGA_WEBHOOK_PORT=8090
PLATEGA_MERCHANT_ID=
PLATEGA_SECRET=
PLATEGA_RETURN_URL=
PLATEGA_FAILED_URL=
# Only for isolated local acceptance, never commercial Telegram traffic:
TELEGRAM_API_BASE=
ALLOW_LOCAL_TELEGRAM_STUB=false
# Read-only discovery, no generation or billing request:
CATALOGUE_ENABLED=true
CATALOGUE_PATH=data/catalogue/models.json
CATALOGUE_PROFILE=
ANYMODEL_TEST_SPEECH_LIVE=false
