# Persistent cross-platform service; native CLI: --env-file .env
DATABASE_URL=postgresql://elevenbot:replace-me@localhost:55432/elevenbot
ACCESS_MODE=private
POSTGRES_PASSWORD=CHANGE_TO_RANDOM_HEX_32_BYTES
APP_DB_PASSWORD=CHANGE_TO_DIFFERENT_RANDOM_HEX_32_BYTES
PROVIDER_MODE=catalogue
GENERATION_ENABLED=false
PAYMENTS_ENABLED=false
ECONOMY_VERIFIED=false
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_IDS=
ADMIN_PASSWORD=
SUPPORT_CONTACT=Поддержка пока не настроена.
TERMS_TEXT=Условия коммерческого сервиса пока не опубликованы.
PRIVACY_TEXT=Политика обработки данных пока не опубликована.
DAILY_PROVIDER_BUDGET_UNITS=0
PROVIDER_COST_BOUND_PER_CHAR=0
RETAIL_CREDITS_PER_CHAR=1
PROVIDER_CONCURRENCY=2
CLODEX_API_KEY=
CLODEX_MUSIC_OWNER=
CLODEX_MUSIC_LIVE=false
FAL_KEY=
FAL_MUSIC_OWNER=
FAL_MUSIC_LIVE=false
CLODEX_TTS_MODEL=
VOICES_FILE=
# External top-ups. Keep off until the merchant and HTTPS callback are verified.
PAYMENT_BACKEND=platega
TOPUP_MODE=off
PLATEGA_ENABLED=false
PLATEGA_PAYMENT_METHOD=2
PLATEGA_WEBHOOK_URL=
