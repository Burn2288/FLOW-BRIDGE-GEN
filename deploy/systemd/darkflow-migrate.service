[Unit]
Description=DarkFlow Gen database migrations
After=postgresql.service network-online.target
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=oneshot
User=darkflow
Group=darkflow
WorkingDirectory=/opt/darkflow
Environment=PYTHONPATH=/opt/darkflow/src
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/etc/darkflow/migration.env
ExecStart=/opt/darkflow/.venv/bin/python -m elevenbot migrate
RemainAfterExit=yes
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
